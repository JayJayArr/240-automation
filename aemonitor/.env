# Loki native OTLP base endpoint. Do not append /v1/logs.
LOKI_OTLP_ENDPOINT=http://loki:3100/otlp

# Prometheus remote-write receiver endpoint.
PROMETHEUS_REMOTE_WRITE_ENDPOINT=http://prometheus:9090/api/v1/write

# Tempo OTLP/gRPC distributor endpoint. Do not include http:// or https:// here.
TEMPO_OTLP_GRPC_ENDPOINT=tempo:4317

# true  = plaintext gRPC from Collector -> Tempo
# false = TLS from Collector -> Tempo, using the system CA store unless you add ca_file.
TEMPO_TLS_INSECURE=true

